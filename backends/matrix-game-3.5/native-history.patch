+def _decode_native_resident_chunk(
+    pipe,
+    initial_c0,
+    all_clean,
+    *,
+    chunk_idx,
+    chunk_size,
+    device,
+    tiled=False,
+):
+    """Decode the accumulated prefix exactly like native batch inference.
+
+    The resident API still returns only the current chunk, but decoding a
+    one-latent anchor plus the current chunk creates a fresh VAE boundary every
+    12 RGB frames. Native distilled inference decodes C0 plus the complete
+    generated latent history in one call, so reproduce that contract here and
+    slice the current chunk from the result.
+    """
+    prefix_latents = torch.cat(
+        [initial_c0.detach().cpu()] + list(all_clean), dim=2
+    )
+    prefix_frames = _decode_latents_to_numpy_frames(
+        pipe,
+        prefix_latents,
+        device,
+        tiled=tiled,
+    )
+    frames_per_chunk = int(chunk_size) * 4
+    frame_start = 1 + int(chunk_idx) * frames_per_chunk
+    frame_end = frame_start + frames_per_chunk
+    if int(prefix_frames.shape[0]) < frame_end:
+        raise RuntimeError(
+            "resident native-prefix decode returned too few frames: "
+            f"observed={int(prefix_frames.shape[0])}, required={frame_end}."
+        )
+    return prefix_frames[frame_start:frame_end]
+
