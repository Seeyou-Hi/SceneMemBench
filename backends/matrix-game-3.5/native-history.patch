+class ResidentCausalRollout:
+    """Advance one already-initialized causal rollout chunk at a time.
+
+    The wrapped generator owns all model-native state, including rolling KV,
+    latent history, dynamic visual context and Patch/Mosaic memory.  No tensor
+    state is reconstructed between :meth:`step` calls.
+    """
+
+    def __init__(self, iterator):
+        self._iterator = iter(iterator)
+        self.chunk_index = 0
+        self.history_cursor = 0
+        self.done = False
+        self.result = None
+
+    def _finish(self, stop):
+        self.done = True
+        self.result = stop.value
+
+    def step(self, camera_update=None):
+        if self.done:
+            raise StopIteration("causal rollout is complete")
+        try:
+            chunk = next(self._iterator)
+        except StopIteration as stop:
+            self._finish(stop)
+            raise
+        if isinstance(chunk, dict) and chunk.get("event") == "camera_request":
+            if camera_update is None:
+                raise RuntimeError(
+                    "interactive causal rollout requires a camera update for "
+                    f"chunk={int(chunk.get('chunk_idx', -1))}."
+                )
+            try:
+                chunk = self._iterator.send(camera_update)
+            except StopIteration as stop:
+                self._finish(stop)
+                raise RuntimeError(
+                    "interactive causal rollout ended while applying a camera update"
+                ) from stop
+        if not isinstance(chunk, dict):
+            raise RuntimeError("resident causal rollout must yield a mapping")
+        expected = int(self.chunk_index)
+        observed = int(chunk.get("chunk_idx", -1))
+        if observed != expected:
+            raise RuntimeError(
+                "resident causal rollout chunk order diverged: "
+                f"expected={expected}, observed={observed}."
+            )
+        cursor_after = int(chunk.get("history_cursor_after", 0))
+        if cursor_after <= self.history_cursor:
+            raise RuntimeError(
+                "resident causal rollout history cursor did not advance: "
+                f"before={self.history_cursor}, after={cursor_after}."
+            )
+        self.chunk_index += 1
+        self.history_cursor = cursor_after
+        if bool(chunk.get("is_last_chunk", False)):
+            try:
+                extra = next(self._iterator)
+            except StopIteration as stop:
+                self._finish(stop)
+            else:
+                raise RuntimeError(
+                    "resident causal rollout yielded data after its final chunk: "
+                    f"{extra!r}"
+                )
+        return chunk
+
+    def close(self):
+        close = getattr(self._iterator, "close", None)
+        if callable(close):
+            close()
+        self.done = True
+
