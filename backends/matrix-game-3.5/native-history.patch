+    try:
+        result = align_poses_umeyama(
+            prediction_extrinsics,
+            input_extrinsics,
+            ransac=use_ransac,
+            return_aligned=True,
+            random_state=42,
+        )
+        return (*result, "ransac" if use_ransac else "umeyama", None)
+    except ValueError as ransac_error:
+        if not _is_zero_translation_variance_error(ransac_error) or not use_ransac:
+            raise
+
+        try:
+            result = align_poses_umeyama(
+                prediction_extrinsics,
+                input_extrinsics,
+                ransac=False,
+                return_aligned=True,
+                random_state=42,
+            )
+            return (*result, "global_umeyama_retry", str(ransac_error))
+        except ValueError as global_error:
+            if not _is_zero_translation_variance_error(global_error):
+                raise
+            return (
+                None,
+                None,
+                1.0,
+                None,
+                "native_metric_fallback",
+                f"RANSAC: {ransac_error}; global: {global_error}",
+            )
