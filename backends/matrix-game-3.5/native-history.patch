+def _register_source_sequence_batched(
+    handler,
+    device,
+    frames,
+    *,
+    extrinsics,
+    intrinsics,
+    depths=None,
+    start_index=0,
+    force_using_input_extrinics=True,
+):
+    """Register source prefixes on a configurable DA3 device and batch size.
+
+    DA3's memory footprint scales with the number of input RGB frames.  The
+    handler already supports contiguous incremental registration, so split
+    only the estimator call while preserving the same global frame indices and
+    memory ordering. A zero batch size keeps the historical single-call path;
+    a separate registration device prevents that full call from competing with
+    the resident generation model.
+    """
+    batch_size = int(
+        os.environ.get("WORLDFOUNDRY_DA3_REGISTRATION_BATCH_FRAMES", "0") or "0"
+    )
+    registration_device = str(
+        os.environ.get("WORLDFOUNDRY_DA3_REGISTRATION_DEVICE", "") or ""
+    ).strip()
+    registration_device = registration_device or device
+    if registration_device != device:
+        print(
+            f"[causal-kv] DA3 source registration device: "
+            f"model={device} registration={registration_device}",
+            flush=True,
+        )
+    if batch_size <= 0 or len(frames) <= batch_size:
+        return handler.register_source_sequence(
+            registration_device,
+            frames,
+            extrinsics=extrinsics,
+            intrinsics=intrinsics,
+            depths=depths,
+            start_index=start_index,
+            force_using_input_extrinics=force_using_input_extrinics,
+        )
+    print(
+        f"[causal-kv] DA3 source registration batching: frames={len(frames)} "
+        f"batch_size={batch_size}",
+        flush=True,
+    )
+    for offset in range(0, len(frames), batch_size):
+        end = min(offset + batch_size, len(frames))
+        handler.register_source_sequence(
+            registration_device,
+            frames[offset:end],
+            extrinsics=np.asarray(extrinsics)[offset:end],
+            intrinsics=np.asarray(intrinsics)[offset:end] if intrinsics is not None else None,
+            depths=np.asarray(depths)[offset:end] if depths is not None else None,
+            start_index=int(start_index) + offset,
+            force_using_input_extrinics=force_using_input_extrinics,
+        )
+    return None
