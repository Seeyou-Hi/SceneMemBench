+
+
+def _align_poses_with_fallback(
+    prediction_extrinsics: np.ndarray,
+    input_extrinsics: np.ndarray,
+    *,
+    ransac_view_thresh: int = 10,
+):
+    """Align DA3 poses, degrading only when the estimated path is degenerate.
+
+    RANSAC can choose an all-rotation/duplicate subset even when the input path
+    translates. A global Umeyama retry handles that case. If DA3's complete
+    estimated path has no translation variance, no Sim(3) scale is identifiable;
+    the caller then keeps DA3's native metric depth and uses scale 1.
+    """
+
