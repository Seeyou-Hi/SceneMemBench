+def _frame_detail_score(frame):
+    arr = np.asarray(frame, dtype=np.float32)
+    gray = arr[..., :3].mean(axis=-1)
+    if min(gray.shape) < 3:
+        return 0.0
+    lap = (
+        -4.0 * gray[1:-1, 1:-1]
+        + gray[:-2, 1:-1]
+        + gray[2:, 1:-1]
+        + gray[1:-1, :-2]
+        + gray[1:-1, 2:]
+    )
+    return float(np.var(lap))
+
+
+def _add_decoded_detail_scores(latent_groups, generated_frames, mosaic_frames):
+    for group in latent_groups:
+        start = int(group["output_frame_start"])
+        end = int(group["output_frame_end"]) + 1
+        generated_slice = generated_frames[start:end]
+        mosaic_slice = mosaic_frames[start:end]
+        group["generated_detail_score"] = float(
+            np.mean([_frame_detail_score(frame) for frame in generated_slice])
+        ) if len(generated_slice) else 0.0
+        group["mosaic_decoded_detail_score"] = float(
+            np.mean([_frame_detail_score(frame) for frame in mosaic_slice])
+        ) if len(mosaic_slice) else 0.0
+
+
+def _write_memory_diagnostics(path, data, frames, mosaic_frames, mosaic_latents):
+    diagnostics = data.get("_causal_memory_diagnostics") or {}
+    candidate_groups = diagnostics.get("candidate_groups") or []
+    candidate_frames_by_id = diagnostics.get("candidate_frames_by_id") or {}
+    candidate_history_frames = _build_validation_candidate_history_frames(
+        history_frame_count=len(frames),
+        single_frame_shape=frames[0].shape,
+        candidate_groups=candidate_groups,
+        candidate_frames_by_id=candidate_frames_by_id,
+    )
+    verbose_frames = _history_verbose_frames(
+        frames,
+        mosaic_frames,
+        candidate_history_frames=candidate_history_frames,
+    )
+    _write_video(path, verbose_frames, fast_debug=True)
+
+    latent_groups = diagnostics.get("latent_groups") or []
+    _add_decoded_detail_scores(latent_groups, frames, mosaic_frames)
+    trace = {
+        "layout": {
+            "top_left": "generated RGB",
+            "bottom_left": "decoded warped/fused mosaic latent",
+            "right": "selected Patch Memory RGB frames; yellow labels are memory frame IDs",
+        },
