+def _encode_teacher_forced_context(
+    pipe,
+    frames,
+    *,
+    frames_per_chunk,
+    device,
+    tiled=False,
+):
+    """Encode GT Context into native causal latents for clean cache replay.
+
+    The first RGB frame is the clean C0 anchor. Every following group of four
+    RGB frames is encoded through the same five-frame window used by native
+    generated dynamic context: ``[previous_rgb, current_rgb_0..3]``. The final
+    group is edge-padded so prefill consumes the complete Context boundary.
+    """
+    frames = np.asarray(frames)
+    if frames.ndim != 4 or int(frames.shape[-1]) != 3:
+        raise RuntimeError(
+            "teacher-forced Context expects (T,H,W,3) RGB frames, "
+            f"got {tuple(frames.shape)}."
+        )
+    if int(frames.shape[0]) < 2:
+        raise RuntimeError("teacher-forced Context requires at least two RGB frames")
+    cs = int(frames_per_chunk)
+    if cs <= 0:
+        raise ValueError(f"frames_per_chunk must be positive, got {cs}")
+    target_frames = np.ascontiguousarray(frames[1:])
+    latent_count = int(math.ceil(int(target_frames.shape[0]) / 4.0))
+    padded_rgb_count = latent_count * 4
+    padding = padded_rgb_count - int(target_frames.shape[0])
+    if padding:
+        target_frames = np.concatenate(
+            [target_frames, np.repeat(target_frames[-1:], padding, axis=0)],
+            axis=0,
+        )
+    windows = []
+    for latent_idx in range(latent_count):
+        start = latent_idx * 4
+        previous = frames[0] if latent_idx == 0 else target_frames[start - 1]
+        windows.append(
+            np.concatenate(
+                [previous[None, ...], target_frames[start : start + 4]], axis=0
+            )
+        )
+    teacher_latents = _encode_context_windows_to_latents(
+        pipe,
+        windows,
+        device=device,
+        tiled=tiled,
+    )
+    if teacher_latents is None or int(teacher_latents.shape[2]) != latent_count:
+        raise RuntimeError(
+            "teacher-forced Context VAE latent count mismatch: "
+            f"expected={latent_count}, observed="
+            f"{None if teacher_latents is None else int(teacher_latents.shape[2])}."
+        )
+    chunk_latent_count = cs
+    chunk_count = int(math.ceil(latent_count / float(chunk_latent_count)))
+    padded_latent_count = chunk_count * chunk_latent_count
+    latent_padding = padded_latent_count - latent_count
+    if latent_padding:
+        teacher_latents = torch.cat(
+            [
+                teacher_latents,
+                teacher_latents[:, :, -1:].repeat(1, 1, latent_padding, 1, 1),
+            ],
+            dim=2,
+        )
+        rgb_padding = latent_padding * 4
+        target_frames = np.concatenate(
+            [target_frames, np.repeat(target_frames[-1:], rgb_padding, axis=0)],
+            axis=0,
+        )
+        padding += rgb_padding
+    return {
+        "anchor_frame": np.ascontiguousarray(frames[:1]),
+        "target_frames": np.ascontiguousarray(target_frames),
+        "latents": teacher_latents.contiguous(),
+        "latent_count": int(teacher_latents.shape[2]),
+        "chunk_count": chunk_count,
+        "padded_rgb_count": int(target_frames.shape[0]),
+        "padding_rgb_count": int(padding),
+    }
