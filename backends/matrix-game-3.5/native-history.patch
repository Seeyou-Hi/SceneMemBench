+def _generated_chunk_appearance_stats(frames, spatial_stride=4):
+    """Return inexpensive low-frequency and detail statistics for RGB frames."""
+    arr = np.asarray(frames)
+    if arr.ndim != 4 or arr.shape[-1] < 3:
+        raise ValueError(
+            "appearance statistics expect (T,H,W,3) frames, "
+            f"got {tuple(arr.shape)}."
+        )
+    stride = max(1, int(spatial_stride))
+    rgb = arr[:, ::stride, ::stride, :3].astype(np.float32, copy=False)
+    red, green, blue = rgb[..., 0], rgb[..., 1], rgb[..., 2]
+    luma = 0.2126 * red + 0.7152 * green + 0.0722 * blue
+    detail_scores = []
+    if luma.shape[1] >= 3 and luma.shape[2] >= 3:
+        for frame in luma:
+            lap = (
+                -4.0 * frame[1:-1, 1:-1]
+                + frame[:-2, 1:-1]
+                + frame[2:, 1:-1]
+                + frame[1:-1, :-2]
+                + frame[1:-1, 2:]
+            )
+            detail_scores.append(float(np.var(lap)))
+    channel_max = rgb.max(axis=-1)
+    channel_min = rgb.min(axis=-1)
+    saturation = np.where(
+        channel_max > 1e-6,
+        (channel_max - channel_min) / np.maximum(channel_max, 1e-6),
+        0.0,
+    )
+    return {
+        "detail": float(np.mean(detail_scores)) if detail_scores else 0.0,
+        "contrast": float(np.std(luma)),
+        "color": [
+            float(np.mean(luma)),
+            float(np.mean(red - green)),
+            float(np.mean(blue - green)),
+        ],
+        "saturation": float(np.mean(saturation)),
+    }
+
+
+def _generated_chunk_appearance_quality(
+    current,
+    trusted,
+    anchor,
+    *,
+    mosaic_valid_ratio=1.0,
+):
+    """Score whether a generated chunk is safe to reuse as appearance context."""
+    eps = 1e-6
+    detail_ratio = float(current["detail"]) / max(float(trusted["detail"]), eps)
+    contrast_ratio = float(current["contrast"]) / max(
+        float(trusted["contrast"]), eps
+    )
+    current_color = np.asarray(current["color"], dtype=np.float64)
+    trusted_color = np.asarray(trusted["color"], dtype=np.float64)
+    anchor_color = np.asarray(anchor["color"], dtype=np.float64)
+    local_color_delta = float(np.linalg.norm(current_color - trusted_color))
+    anchor_color_delta = float(np.linalg.norm(current_color - anchor_color))
+
+    detail_factor = float(np.clip(detail_ratio / 0.65, 0.0, 1.0))
+    contrast_factor = float(np.clip(contrast_ratio / 0.75, 0.0, 1.0))
+    color_delta = max(local_color_delta, 0.35 * anchor_color_delta)
+    color_factor = float(np.exp(-color_delta / 30.0))
+    valid_factor = 0.5 + 0.5 * float(
+        np.clip(float(mosaic_valid_ratio) / 0.7, 0.0, 1.0)
+    )
+    quality = (
+        detail_factor ** 0.45
+        * contrast_factor ** 0.20
+        * color_factor ** 0.25
+        * valid_factor ** 0.10
+    )
+    return {
+        "quality": float(np.clip(quality, 0.0, 1.0)),
+        "detail_ratio": detail_ratio,
+        "contrast_ratio": contrast_ratio,
+        "local_color_delta": local_color_delta,
+        "anchor_color_delta": anchor_color_delta,
+        "mosaic_valid_ratio": float(mosaic_valid_ratio),
+        "detail_factor": detail_factor,
+        "contrast_factor": contrast_factor,
+        "color_factor": color_factor,
+        "valid_factor": valid_factor,
+    }
+
